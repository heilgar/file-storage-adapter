{
  "name": "@heilgar/file-storage-adapter-fs",
  "version": "2.0.0",
  "description": "Local filesystem file storage adapter for Node.js — unified API shared with the AWS S3 and Vercel Blob adapters.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "homepage": "https://github.com/heilgar/file-storage-adapter#readme",
