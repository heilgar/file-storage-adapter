{
  "name": "@heilgar/file-storage-adapter-vercel-blob",
  "version": "2.0.0",
  "description": "Vercel Blob file storage adapter for Node.js (public + private stores, signed URLs) — unified API shared with the filesystem and AWS S3 adapters.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "homepage": "https://github.com/heilgar/file-storage-adapter#readme",
  "bugs": {
    "url": "https://github.com/heilgar/file-storage-adapter/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/heilgar/file-storage-adapter"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "storage",
    "file-storage",
    "object-storage",
    "vercel",
    "vercel-blob",
    "blob",
    "presigned-url",
    "signed-url",
    "adapter",
    "adapter-pattern",
    "typescript",
    "nodejs",
    "edge"
  ],
  "author": "heilgar",
  "license": "MIT",
  "dependencies": {
    "@heilgar/file-storage-adapter-core": "^2.0.0",
    "@vercel/blob": "^2.4.0",
    "mime-types": "^3.0.2"
  },
  "devDependencies": {
    "@heilgar/file-storage-adapter-core": "*",
    "@types/node": "^24.0.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.4"
  }
}
