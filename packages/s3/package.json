{
  "name": "@heilgar/file-storage-adapter-s3",
  "version": "2.0.0",
  "description": "AWS S3 (and S3-compatible: LocalStack, MinIO) file storage adapter for Node.js — unified API shared with the filesystem and Vercel Blob adapters.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "homepage": "https://github.com/heilgar/file-storage-adapter#readme",
  "bugs": {
    "url": "https://github.com/heilgar/file-storage-adapter/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/heilgar/file-storage-adapter"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "storage",
    "file-storage",
    "object-storage",
    "cloud-storage",
    "s3",
    "aws",
    "aws-s3",
    "minio",
    "localstack",
    "presigned-url",
    "signed-url",
    "adapter",
    "adapter-pattern",
    "typescript",
    "nodejs"
  ],
  "author": "heilgar",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1030.0",
    "@aws-sdk/s3-request-presigner": "^3.1030.0",
    "@heilgar/file-storage-adapter-core": "^2.0.0",
    "mime-types": "^3.0.2"
  },
  "devDependencies": {
    "@heilgar/file-storage-adapter-core": "*",
    "@types/node": "^24.0.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.4"
  }
}
