{
  "name": "@heilgar/file-storage-adapter-core",
  "version": "2.0.0",
  "description": "Core interfaces and base adapter for @heilgar/file-storage-adapter — the typed contract for unified file storage in Node.js and TypeScript.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "homepage": "https://github.com/heilgar/file-storage-adapter#readme",
  "bugs": {
    "url": "https://github.com/heilgar/file-storage-adapter/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/heilgar/file-storage-adapter"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --build",
    "test": "vitest run --config ../../vitest.config.js",
    "test:watch": "vitest --config ../../vitest.config.js"
  },
  "keywords": [
    "storage",
    "file-storage",
    "adapter",
    "adapter-pattern",
    "core",
    "interfaces",
    "abstraction",
    "typescript",
    "nodejs"
  ],
  "author": "heilgar",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4"
  }
}
